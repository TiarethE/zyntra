skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 6
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam ArrowColor #3B4252
skinparam ClassBorderColor #3B4252
skinparam ClassBackgroundColor #F7F8FA
skinparam ClassHeaderBackgroundColor #E5E9F0
skinparam PackageBorderColor #9AA3B2
skinparam PackageFontColor #3B4252
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #D8B85A
skinparam titleFontSize 15
skinparam titleFontStyle bold

skinparam class {
  BackgroundColor<<Creator>> #E3EDFA
  BorderColor<<Creator>> #2B5C9E
  StereotypeFontColor<<Creator>> #2B5C9E
  BackgroundColor<<ConcreteCreator>> #E3EDFA
  BorderColor<<ConcreteCreator>> #2B5C9E
  StereotypeFontColor<<ConcreteCreator>> #2B5C9E
  BackgroundColor<<Product>> #E3EDFA
  BorderColor<<Product>> #2B5C9E
  StereotypeFontColor<<Product>> #2B5C9E
  BackgroundColor<<ConcreteProduct>> #E3EDFA
  BorderColor<<ConcreteProduct>> #2B5C9E
  StereotypeFontColor<<ConcreteProduct>> #2B5C9E
  BackgroundColor<<Component>> #E3F4EA
  BorderColor<<Component>> #1E7A46
  StereotypeFontColor<<Component>> #1E7A46
  BackgroundColor<<ConcreteComponent>> #E3F4EA
  BorderColor<<ConcreteComponent>> #1E7A46
  StereotypeFontColor<<ConcreteComponent>> #1E7A46
  BackgroundColor<<Decorator>> #E3F4EA
  BorderColor<<Decorator>> #1E7A46
  StereotypeFontColor<<Decorator>> #1E7A46
  BackgroundColor<<ConcreteDecorator>> #E3F4EA
  BorderColor<<ConcreteDecorator>> #1E7A46
  StereotypeFontColor<<ConcreteDecorator>> #1E7A46
  BackgroundColor<<Context>> #FCEBDD
  BorderColor<<Context>> #B85A12
  StereotypeFontColor<<Context>> #B85A12
  BackgroundColor<<State>> #FCEBDD
  BorderColor<<State>> #B85A12
  StereotypeFontColor<<State>> #B85A12
  BackgroundColor<<ConcreteState>> #FCEBDD
  BorderColor<<ConcreteState>> #B85A12
  StereotypeFontColor<<ConcreteState>> #B85A12
  BackgroundColor<<Subject>> #EEE6F7
  BorderColor<<Subject>> #6B3FA0
  StereotypeFontColor<<Subject>> #6B3FA0
  BackgroundColor<<Observer>> #EEE6F7
  BorderColor<<Observer>> #6B3FA0
  StereotypeFontColor<<Observer>> #6B3FA0
  BackgroundColor<<ConcreteObserver>> #EEE6F7
  BorderColor<<ConcreteObserver>> #6B3FA0
  StereotypeFontColor<<ConcreteObserver>> #6B3FA0
  BackgroundColor<<Event>> #EEE6F7
  BorderColor<<Event>> #6B3FA0
  StereotypeFontColor<<Event>> #6B3FA0
  BackgroundColor<<Legado>> #FBE4E4
  BorderColor<<Legado>> #A33030
  StereotypeFontColor<<Legado>> #A33030
}
hide <<Legado>> stereotype

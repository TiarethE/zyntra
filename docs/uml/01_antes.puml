@startuml antes
!include estilo.iuml
title ANTES (v0.1): una sola clase concentra datos, costos y estados
class "Envio" as Envio <<Legado>> {
  +numero_guia : str
  +destino : str
  +tipo : str
  +peso : float
  +fragil : bool
  +asegurado : bool
  +valor_declarado : float
  +estado : str
  --
  +calcular_costo() : int
  +cambiar_estado(nuevo_estado : str) : bool
}
note left of Envio
